# Core application
NODE_ENV=production
URL=https://outline.localhost:9443
PORT=3000
SECRET_KEY=replace-with-a-random-64-character-secret
UTILS_SECRET=replace-with-a-second-random-64-character-secret

# Database and Redis
DATABASE_URL=postgres://outline:replace-with-postgres-password@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# Local file storage
FILE_STORAGE=local
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400
FILE_STORAGE_IMPORT_MAX_SIZE=5242880
FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE=5242880

# Proxy and HTTPS
FORCE_HTTPS=true

# SMTP (optional during initial local setup)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_REPLY_EMAIL=

# OpenID Connect / Keycloak
OIDC_ISSUER_URL=http://keycloak.local:5001/realms/outline
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=replace-with-the-keycloak-client-secret
OIDC_DISPLAY_NAME=Keycloak
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email
OIDC_DISABLE_REDIRECT=false

# Logging
LOG_LEVEL=info
